{
  "name": "zth-design-studio",
  "version": "4.0.0",
  "description": "Offline poster design for studios and clubs / 工作室与社团离线平面设计器",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:win": "node scripts/build-windows.cjs",
    "build:portable": "node scripts/sync-legal.cjs && electron-builder --win portable --x64 --publish never",
    "build:web": "node scripts/build-web.cjs",
    "build:android": "node scripts/build-android.cjs",
    "build:ios": "node scripts/prepare-ios.cjs",
    "package:win": "node scripts/package-windows.cjs",
    "build:legal": "node scripts/sync-legal.cjs"
  },
  "keywords": [],
  "author": "理工阿白菌 / TechABJ · ZeroToHand Studio",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.12",
    "fabric": "7.4.0",
    "jspdf": "4.2.1",
    "jszip": "^3.10.1",
    "lucide": "1.72.0",
    "pdfjs-dist": "^5.4.394",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "build": {
    "appId": "studio.zerotohand.design",
    "productName": "ZTH Design Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "name": "zth-design-studio"
    },
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "signExecutable": false,
      "artifactName": "ZTH-Design-Studio-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZTH-平面设计器",
      "license": "build/license.txt",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "displayLanguageSelector": true
    },
    "fileAssociations": []
  }
}
